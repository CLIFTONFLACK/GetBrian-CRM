# Neon Postgres — Vercel dashboard → Storage tab → the Neon project → .env.local
# tab (copies both variants for you). Server-only; NEVER prefix with NEXT_PUBLIC
# (see src/lib/db/client.ts — there is deliberately no client-side DB credential).
# NOTE: the code reads STORAGE_CRM_DATABASE_URL (the exact name Vercel's Storage
# tab assigned this resource), NOT a bare DATABASE_URL — they must match.
STORAGE_CRM_DATABASE_URL=
# STORAGE_CRM_DATABASE_URL_UNPOOLED=

# Auth.js (next-auth) session signing secret. Generate with:
#   openssl rand -base64 32
# Server-only; NEVER prefix with NEXT_PUBLIC. Required once STORAGE_CRM_DATABASE_URL
# is set — see src/lib/auth/index.ts.
AUTH_SECRET=

# Vercel Blob — Vercel dashboard → Storage tab → the Blob store → .env.local tab.
# Server-only; NEVER prefix with NEXT_PUBLIC (see src/app/api/blob/client-upload/route.ts
# — browser uploads get a short-lived scoped token, never this).
BLOB_READ_WRITE_TOKEN=
DOC_SIGNING_SECRET=

# Upstash Redis via Vercel's KV wrapper — Vercel dashboard → Storage tab → the
# KV/Upstash store → .env.local tab. Used for rate limiting (see
# src/lib/rate-limit.ts) on /login and the public /submit-requirement intake
# form. Server-only; NEVER prefix with NEXT_PUBLIC. Optional: rate limiting
# fails open (always allows) when unset, so local dev works without it.
# Named KV_REST_API_* (not UPSTASH_REDIS_REST_*) — that's Vercel's own naming
# for this integration, not the raw Upstash SDK naming.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google Maps — https://console.cloud.google.com/google/maps-apis
# Enable billing, then enable these 3 APIs: Maps JavaScript API, Geocoding API, Maps Static API.
# Browser key: exposed to the browser — restrict by HTTP referrer + to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: NEVER prefix with NEXT_PUBLIC. Restrict to the Geocoding API + Maps Static API.
GOOGLE_MAPS_SERVER_KEY=

# Email — "Send Deal → External" delivery via Resend (https://resend.com).
# API key from the Resend dashboard. Server-only; NEVER prefix with NEXT_PUBLIC.
RESEND_API_KEY=
# Verified sender, e.g. "CDG Leisure <deals@yourdomain.com>". Must be on a domain
# verified in Resend (or use onboarding@resend.dev for testing).
EMAIL_FROM=
# Resend webhook signing secret ("whsec_…") for POST /api/webhooks/resend
# engagement tracking (delivered/opened/clicked/bounced). Server-only; NEVER
# prefix with NEXT_PUBLIC. In production the route FAILS CLOSED (503) when this
# is unset, so forged tracking events can't be accepted; outside production,
# unsigned requests are allowed so local testing works without it.
RESEND_WEBHOOK_SECRET=

# Public intake (/submit-requirement) — no session, so the target agency is
# resolved server-side from this agent's email, never from the form. See
# src/lib/actions/public-intake.ts. Falls back to hardcoded defaults if unset.
# INTAKE_DEFAULT_AGENT_EMAIL=
# INTAKE_ADMIN_EMAIL=

# Vercel Cron bearer secret for GET /api/cron/due (see vercel.json's schedule
# and src/app/api/cron/due/route.ts). Vercel sends this automatically as
# `Authorization: Bearer <value>` when set; the route 503s without it.
CRON_SECRET=

# KYC — UK company due diligence.
# Companies House Public Data API: free key from
# https://developer.company-information.service.gov.uk (Register → create an application →
# generate a REST API key). Server-only; NEVER prefix with NEXT_PUBLIC.
COMPANIES_HOUSE_API_KEY=
# Optional override for the OFSI consolidated sanctions list (defaults to the live URL).
# OFSI_CONSOLIDATED_LIST_URL=
# Didit — OPTIONAL, paid KYB/AML ($2/company). Leave blank to disable; the free
# official sources remain the source of truth.
# DIDIT_API_KEY=
# DIDIT_API_URL=
